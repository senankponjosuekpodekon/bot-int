# API Dockerfile
FROM node:22-slim AS builder

WORKDIR /app

# Copy root package files for monorepo
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/payment-sdk/package.json ./packages/payment-sdk/

# Skip bundled Chromium download — production uses the system package below.
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

RUN npm ci --silent
COPY packages/payment-sdk ./packages/payment-sdk
RUN npm run build -w @stiamond/payment-sdk

# Copy API source
COPY apps/api ./apps/api
COPY apps/web ./apps/web

# Build API
RUN cd apps/api && npx nest build

# --- Production stage ---
FROM node:22-slim AS production

# System Chromium for Puppeteer (knowledge URL scraping) — puppeteer-core connects
# to it via PUPPETEER_EXECUTABLE_PATH; the bundled download is skipped in the builder.
RUN apt-get update \
  && apt-get install -y --no-install-recommends chromium fonts-liberation \
  && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/payment-sdk/package.json ./packages/payment-sdk/
COPY --from=builder /app/packages/payment-sdk/dist ./packages/payment-sdk/dist

RUN npm ci --omit=dev --silent

COPY --from=builder /app/apps/api/dist ./apps/api/dist

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:'+(process.env.PORT||3001)+'/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

WORKDIR /app/apps/api
CMD ["node", "dist/main"]
