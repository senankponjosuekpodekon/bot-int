PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=stiamond_agent
# DATABASE_URL=postgres://user:password@host:5432/db?sslmode=require

# Auth
JWT_SECRET=change_this_to_a_very_long_random_secret

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=llama3.1

# LLM Provider — ollama | openai
LLM_PROVIDER=ollama

# OpenAI (used when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1

# Cache / Session (optional — falls back to in-memory if not set)
REDIS_URL=redis://localhost:6379
CACHE_TTL=300

# Encryption at rest (required in production)
ENCRYPTION_KEY=change_this_to_a_32_plus_char_long_random_secret

# Shopify webhook verification (optional — required if using Shopify integration)
# SHOPIFY_WEBHOOK_SECRET=

# Demo credentials (created in @/apps/api/src/seed.ts:57):
# Email: demo@stiamond.dev
# Password: Demo123!
# Role: admin
# Tenant: Stiamond Demo (plan: pro)