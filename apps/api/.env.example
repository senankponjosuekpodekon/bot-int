PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=stiamond_agent

# Auth
JWT_SECRET=change_this_to_a_very_long_random_secret

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000

# Redis (optional — backs the API rate limiter; in-memory if unset)
# External apps must use the TLS endpoint; on the VPS itself use the internal URL.
REDIS_URL=rediss://:<password>@redis.stiamond.net:6380

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
