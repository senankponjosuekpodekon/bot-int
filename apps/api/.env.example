PORT=3001
NODE_ENV=development

# Database
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=stiamond_agent
DATABASE_URL=postgres://user:password@host:5432/db?sslmode=require

# Sync schema on first deploy (set to false after)
DB_SYNC=false

# Auth
JWT_SECRET=change_this_to_a_very_long_random_secret

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=llama3.1

# LLM Provider — ollama | openai
LLM_PROVIDER=ollama

# OpenAI (used when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBED_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBED_API_KEY=sk-...

# Groq (use with LLM_PROVIDER=openai + OPENAI_BASE_URL set to Groq)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=openai/gpt-oss-120b

# Jina AI — free embeddings, OpenAI-compatible-ish endpoint
# OPENAI_EMBED_BASE_URL=https://api.jina.ai/v1
# OPENAI_EMBED_API_KEY=jina_...
# OPENAI_EMBED_MODEL=jina-embeddings-v5-omni-small
# JINA_EMBED_TASK=retrieval.query   # retrieved.query for search, retrieval.passage for chunks (auto-set in code)
# JINA_EMBED_NORMALIZED=true

# Cache / Session (optional — falls back to in-memory if not set)
REDIS_URL=redis://localhost:6379
CACHE_TTL=300

# Encryption at rest (required in production)
ENCRYPTION_KEY=change_this_to_a_32_plus_char_long_random_secret

# Shopify webhook verification (optional — required if using Shopify integration)
# SHOPIFY_WEBHOOK_SECRET=

# Payment providers (Stripe required for subscriptions; others optional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_SCALE=
# STRIPE_PRICE_ENTERPRISE=
# APP_URL=http://localhost:3000
# MONEROO_API_KEY=
# WISE_API_KEY=
# COINBASE_API_KEY=

# Demo credentials (created in @/apps/api/src/seed.ts:57):
# Email: demo@stiamond.dev
# Password: Demo123!
# Role: admin
# Tenant: Stiamond Demo (plan: pro)