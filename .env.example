# Backend (apps/api)
NODE_ENV=development
API_PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bot_int
DB_POOL_SIZE=20
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL_MINUTES=10080
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
NEXTAUTH_SECRET=update-me

# Security
CORS_ORIGINS=http://localhost:3000,https://stiamond.com
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
ENCRYPTION_KEY=change-me-to-32-char-random-secret

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_OLLAMA_MODEL=llama3.1

# Redis (optional, for cache + queue)
REDIS_URL=redis://localhost:6379

# SSL / Let’s Encrypt
SSL_DOMAIN=stiamond.com
SSL_EMAIL=admin@stiamond.com

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# Other payment providers (optional)
MONEROO_API_KEY=
WISE_API_KEY=
COINBASE_API_KEY=

# Optional tenants / integrations
DEFAULT_TENANT_SLUG=stiamond
DEFAULT_TENANT_ID=
DEFAULT_AGENT_ID=

# Observability (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
