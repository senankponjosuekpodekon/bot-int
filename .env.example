# Backend (apps/api)
NODE_ENV=development
API_PORT=3001
# Preferred in production (Neon, RDS…). Overrides DB_* vars when set.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bot_int
DB_POOL_SIZE=10
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL_MINUTES=10080
# Number of proxy hops to trust for the client IP (nginx=1)
TRUST_PROXY=1
# Dev helper pages (/api/admin, /api/operator, /api/widget-demo) — keep unset/false in prod
ENABLE_DEBUG_PAGES=false
# Schema sync: allowed in dev only, never in production
DB_SYNC=true

# LLM (fallback: primary → secondary, see FallbackLLMProvider)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Custom OpenAI-compatible endpoint (Groq, OpenRouter, Azure…)
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_URL=https://ollama.stiamond.net
OLLAMA_MODEL=llama3.1:latest
# Separate model for embeddings (nomic-embed-text recommended → EMBEDDING_DIMS=768)
OLLAMA_EMBED_MODEL=llama3.1
# Cloudflare Access Service Token for ollama.stiamond.net (optional, for security)
OLLAMA_CF_ACCESS_CLIENT_ID=
OLLAMA_CF_ACCESS_CLIENT_SECRET=
# Embeddings can use a different endpoint/key than chat (e.g. Jina AI)
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_API_KEY=
OPENAI_EMBED_BASE_URL=
# Jina AI flags (when OPENAI_EMBED_BASE_URL=https://api.jina.ai/v1)
JINA_EMBED_TASK=retrieval.query
JINA_EMBED_NORMALIZED=true
# Debug: log the full LLM prompt context (dev only)
LOG_LLM_CONTEXT=false
# Set to true to bypass billing quota (temporary, for testing only)
BILLING_BYPASS_QUOTA=false
NEXTAUTH_SECRET=update-me

# Security
CORS_ORIGINS=http://localhost:3000,https://stiamond.com
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
ENCRYPTION_KEY=change-me-to-32-char-random-secret

# App / site URLs — used to build public links (survey links, billing
# redirects, tenant site pages, SEO)
APP_URL=http://localhost:3000
WEB_URL=http://localhost:3000
SITE_URL=http://localhost:3000
SITE_DOMAIN=agents.stiamond.net
# Alternate port name honored by the API bootstrap (PaaS-style)
PORT=3001
# Grants super-admin to a user matching this email (register or existing)
SUPER_ADMIN_EMAIL=

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DOMAIN=agents.stiamond.net
# Agent id embedded on the marketing page widget demo (optional)
NEXT_PUBLIC_WIDGET_AGENT_ID=

# Redis (optional, for cache + queue)
REDIS_URL=redis://localhost:6379

# Queue worker — poll base interval + max backoff when idle
QUEUE_BATCH_SIZE=5
QUEUE_CONCURRENCY=5
QUEUE_POLL_INTERVAL_MS=5000
QUEUE_POLL_MAX_INTERVAL_MS=60000

# Meta (WhatsApp + Instagram) — embedded signup + inbound webhooks.
# META_APP_SECRET verifies centralized webhook signatures; the per-channel
# *_APP_SECRET entries are optional fallbacks. All fail closed when unset.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Token you invent, then set in the Meta app's webhook config
META_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
INSTAGRAM_APP_SECRET=

# Shopify webhook signature verification (required for the Shopify integration)
SHOPIFY_WEBHOOK_SECRET=

# SSL / Let’s Encrypt
SSL_DOMAIN=stiamond.com
SSL_EMAIL=admin@stiamond.com

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_ENTERPRISE=

# Other payment providers (optional)
MONEROO_API_KEY=
WISE_API_KEY=
COINBASE_API_KEY=

# Optional tenants / integrations
DEFAULT_TENANT_SLUG=stiamond
DEFAULT_TENANT_ID=
DEFAULT_AGENT_ID=
# Seed script only: alternate .env path for API_ENV_PATH users
API_ENV_PATH=

# Knowledge (RAG)
KNOWLEDGE_SIMILARITY_THRESHOLD=0.2
FORBIDDEN_BRAND_NAMES=stiamond,systeme.io

# Observability (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Cloudflare Turnstile (bot protection on public widget endpoints — optional,
# enabled only when TURNSTILE_SECRET_KEY is set)
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# Auto-register agent allowedDomains on the Turnstile widget via Cloudflare API.
# Token needs Account.Turnstile:Edit permission on the account.
CF_API_TOKEN=
CF_ACCOUNT_ID=
# Override widget id for domain sync (defaults to TURNSTILE_SITE_KEY)
TURNSTILE_WIDGET_ID=

# Prometheus metrics endpoint (GET /api/metrics, Bearer auth; disabled when unset)
METRICS_TOKEN=

# LLM resilience
LLM_TIMEOUT_MS=30000
LLM_EMBED_TIMEOUT_MS=15000
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN_MS=60000
LLM_HEALTH_CACHE_MS=30000

# Embedding model output size — must match OPENAI_EMBED_MODEL / Jina / Ollama model
EMBEDDING_DIMS=1536
NEXT_PUBLIC_META_APP_ID=1648868096933302
NEXT_PUBLIC_META_EMBEDDED_CONFIG_ID=1433508329846191
