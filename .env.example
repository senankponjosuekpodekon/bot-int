# Backend (apps/api)
NODE_ENV=development
API_PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bot_int
DB_POOL_SIZE=20
JWT_SECRET=change-me-in-production-use-a-long-random-string
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
NEXTAUTH_SECRET=update-me

# Security
CORS_ORIGINS=http://localhost:3000,https://stiamond.com
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_OLLAMA_MODEL=llama3.2

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# Redis (optional, for cache + queue)
REDIS_URL=redis://localhost:6379

# Optional tenants / integrations
DEFAULT_TENANT_SLUG=stiamond
DEFAULT_AGENT_ID=
