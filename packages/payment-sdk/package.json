{
  "name": "@stiamond/payment-sdk",
  "version": "0.1.0",
  "description": "Payment SDK for Stiamond SaaS products",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "stripe": "^15.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stiamond/payment-sdk.git"
  },
  "keywords": [
    "payments",
    "stripe",
    "saas",
    "sdk"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
